include_guard(GLOBAL)
if(NOT WIN32 OR NOT HE_WINDOWS_ARCH STREQUAL "arm64")
    return()
endif()
# The Windows ARM64 SDK ships the offline renderer without its optional OIDN
# backend. Never inherit an enabled x64 cache entry or stage its CPU DLLs.
set(HE_OFFLINE_OIDN OFF CACHE BOOL "OIDN is not shipped in the Windows ARM64 SDK" FORCE)
set(heArmDefaultRoot "${CMAKE_SOURCE_DIR}/out/agent/dependencies/windows-arm64")
if(DEFINED ENV{HE_WINDOWS_ARM64_ROOT} AND NOT "$ENV{HE_WINDOWS_ARM64_ROOT}" STREQUAL "")
    set(heArmDefaultRoot "$ENV{HE_WINDOWS_ARM64_ROOT}")
endif()
set(HE_WINDOWS_ARM64_ROOT "${heArmDefaultRoot}" CACHE PATH "Pinned native Windows ARM64 dependency SDK")
if(NOT EXISTS "${HE_WINDOWS_ARM64_ROOT}/prepared.json")
    message(FATAL_ERROR "Prepare Windows ARM64 dependencies with Tools/Dependencies/Prepare-WindowsArm64.ps1 first.")
endif()
file(READ "${HE_WINDOWS_ARM64_ROOT}/prepared.json" heArmDependencies)
string(JSON heArmAgility GET "${heArmDependencies}" agility)
string(JSON heArmDxc GET "${heArmDependencies}" dxc)
string(JSON heArmPython GET "${heArmDependencies}" python)
string(JSON heArmFsr GET "${heArmDependencies}" fsr)
string(JSON HE_ARM64_RUNTIME_ROOT GET "${heArmDependencies}" runtimeRoot)
foreach(heArmPath IN ITEMS heArmAgility heArmDxc heArmPython heArmFsr HE_ARM64_RUNTIME_ROOT)
    file(TO_CMAKE_PATH "${${heArmPath}}" ${heArmPath})
endforeach()
set(HE_FSR31_ROOT "${heArmFsr}" CACHE PATH "Hash-pinned FidelityFX SDK ARM64 source" FORCE)
set(HE_D3D12_AGILITY_SDK_ROOT "${heArmAgility}" CACHE PATH "Pinned ARM64 Agility SDK")
set(HE_ARM64_DXC_ROOT "${heArmDxc}/build/native/bin/arm64")
set(HE_ARM64_PYTHON_ROOT "${heArmPython}/tools")
if(NOT HE_CODEGEN_PARSER_EXECUTABLE AND EXISTS "${HE_WINDOWS_ARM64_ROOT}/host-parser/HEngineParser.exe")
    set(HE_CODEGEN_PARSER_EXECUTABLE "${HE_WINDOWS_ARM64_ROOT}/host-parser/HEngineParser.exe"
        CACHE FILEPATH "Pinned build-host reflection parser" FORCE)
endif()
