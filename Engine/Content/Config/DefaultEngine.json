            "Color": { "Contrast": 1.0, "Saturation": 1.0, "Temperature": 0.0 },
            "LocalExposure": { "ShadowStrength": 0.0, "HighlightStrength": 0.0, "MaxEV": 2.0 }
        },
        "SkinSubsurface": { "Enabled": false, "RadiusMeters": 0.003, "Quality": 1 },
        "Shadows": { "Enabled": true, "ContinuousPcfEnabled": true }
