{
    "Schema": "hengine.render-settings",
    "SchemaVersion": 2,
    "Rendering": {
        "Pipeline": {
            "Type": "realtime", "Profile": "Default",
            "Features": [
                { "type": "builtin.cloud", "version": 1, "instance": "cloud", "enabled": true, "parameters": {} },
                { "type": "builtin.outline", "version": 1, "instance": "outline", "enabled": true, "parameters": {} },
                { "type": "builtin.postprocess", "version": 1, "instance": "postprocess", "enabled": true, "parameters": {} }
            ]
        },
        "Views": { "Overrides": {} },
        "Backend": "DX12",
        "Clouds": { "Quality": "Off", "RenderScale": 0.5, "MaxSteps": 40, "LightSteps": 3, "HistoryWeight": 0.85, "DetailDistance": 1800.0, "Temporal": true, "DebugView": 0 },
        "Path": "Deferred",
        "Resolution": { "RenderHeight": 0 },
        "TextureStreaming": { "BudgetMiB": 512 },
        "Upscaling": { "Mode": "Off", "Quality": "Quality", "Sharpness": 0.2 },
        "AO": { "Enabled": true, "Technique": "GTAO", "Radius": 1.0, "Intensity": 1.0, "NormalBias": 0.01, "SliceCount": 4, "StepsPerSide": 8, "SampleCount": 16, "FastUpsample": false },
        "Occlusion": { "Enabled": false },
        "GpuTightFrustum": { "Enabled": false },
        "GpuBatching": { "Enabled": false, "ShadowsEnabled": false },
        "Memory": { "TransientTextureReuse": false, "TransientCacheBudgetMiB": 0 },
        "LOD": { "Enabled": false, "MaxPixelError": 1.0 },
        "Reflections": {
            "Probes": { "Enabled": true },
            "SSR": {
                "Enabled": true, "GuideCacheEnabled": false,
                "MaximumDistance": 50.0, "Thickness": 0.2, "RoughnessCutoff": 0.6,
                "EdgeFade": 0.08, "NormalBias": 0.03, "StepCount": 64, "BinaryRefinementSteps": 5
            }
        },
        "Presentation": { "VSync": false, "FramesInFlight": 3 },
        "AntiAliasing": {
            "Mode": "None",
            "MsaaSamples": 4,
            "FxaaEdgeThreshold": 0.125,
            "FxaaEdgeThresholdMin": 0.0312,
            "FxaaSubpixelQuality": 0.75,
            "SmaaEdgeThreshold": 0.06,
            "SmaaMaxSearchSteps": 24,
            "SmaaMaxDiagonalSearchSteps": 8,
            "SmaaCornerRounding": 0.25,
            "TaaHistoryWeight": 0.92,
            "TaaSharpness": 0.15,
            "TaaOptimizedHistoryGather": false,
            "TaaSharedNeighborhood": false
        },
        "GI": {
            "Technique": "Off",
            "Denoiser": "SVGF",
            "UnsupportedFallback": "Off",
            "RenderScale": 0.5,
            "SamplesPerPixel": 1,
            "MaxBounces": 1,
            "AtrousIterations": 2,
            "BilateralUpsample": true,
            "SVGF": { "OptimizedKernels": true, "SharedUncertainty": false },
            "SSGI": {
                "LocalReactiveBudget": false,
                "EnvironmentMIS": true,
                "DiffuseHitDistanceWeight": 1.0,
                "RayCount": 1,
                "StepCount": 64,
                "HiZStartMip": 2,
                "BinaryRefinementSteps": 3,
                "MaximumRayDistance": 10.0,
                "Thickness": 0.1,
                "EdgeFade": 0.05,
                "TemporalWeight": 0.97
