<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <HEngineRoot Condition="'$(HEngineRoot)' == ''">$(HE_ENGINE_ROOT)</HEngineRoot>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeFrameworkVersion>10.0.10</RuntimeFrameworkVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <Import Project="$(HEngineRoot)/Engine/Managed/Platform.props" />
  <ItemGroup>
    <ProjectReference Include="$(HEngineRoot)/Engine/Managed/HEngine.ScriptCore/HEngine.ScriptCore.csproj" />
  </ItemGroup>
</Project>
