cmake_minimum_required(VERSION 3.19)
if(NOT DEFINED OUTPUT_DIR)
    message(FATAL_ERROR "OUTPUT_DIR is required")
endif()
file(READ "${CMAKE_CURRENT_LIST_DIR}/Api.schema.json" schema)
file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/Api.schema.json" schemaIdentity)
string(JSON version GET "${schema}" version)
string(JSON sceneServiceVersion GET "${schema}" sceneServiceVersion)
set(cpp "// Generated from Tools/Scripting/Api.schema.json. Do not edit.\n#pragma once\n#include <cstdint>\nnamespace HEngine::ScriptAbi {\ninline constexpr std::uint32_t Version = ${version};\n")
set(cs "// Generated from Tools/Scripting/Api.schema.json. Do not edit.\nusing System.Runtime.InteropServices;\nnamespace HEngine.Scripting.Interop;\n/// <summary>Generated ABI schema identity used by verified host generations.</summary>\npublic static class ScriptApiIdentity {\n/// <summary>SHA-256 of the single native/managed ABI schema.</summary>\npublic const string Schema = \"${schemaIdentity}\";\n}\n")
string(APPEND cpp "inline constexpr std::uint32_t SceneServiceVersion = ${sceneServiceVersion};\n")
foreach(kind IN ITEMS managed engine lifecycle)
    if(kind STREQUAL "managed")
        set(enumName ManagedOperation)
    elseif(kind STREQUAL "engine")
        set(enumName EngineOperation)
    else()
        set(enumName ScriptLifecycle)
    endif()
    string(APPEND cpp "enum class ${enumName} : std::uint32_t {\n")
    string(APPEND cs "/// <summary>Generated stable ${kind} dispatch identifiers. Unknown values are rejected.</summary>\npublic enum ${enumName} : uint {\n")
    string(JSON count LENGTH "${schema}" "${kind}Operations")
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON name MEMBER "${schema}" "${kind}Operations" ${index})
        string(JSON value GET "${schema}" "${kind}Operations" "${name}")
        string(APPEND cpp "    ${name} = ${value},\n")
        string(APPEND cs "    /// <summary>Explicit ${name} dispatch slot.</summary>\n    ${name} = ${value},\n")
    endforeach()
    string(APPEND cpp "};\n")
    string(APPEND cs "}\n")
endforeach()
string(APPEND cpp "#pragma pack(push, 8)\nstruct Request {\n")
string(APPEND cs "/// <summary>Synchronous fixed-layout host request. Pointer fields are borrowed only for the duration of a call.</summary>\n[StructLayout(LayoutKind.Sequential, Pack = 8)]\npublic unsafe struct Request {\n")
string(JSON count LENGTH "${schema}" request)
math(EXPR last "${count} - 1")
foreach(index RANGE 0 ${last})
    string(JSON name GET "${schema}" request ${index} 0)
    string(JSON type GET "${schema}" request ${index} 1)
    if(type STREQUAL "float16")
        string(APPEND cpp "    float ${name}[16]{};\n")
        string(APPEND cs "    /// <summary>Sixteen operation-defined numeric payload slots.</summary>\n    public fixed float ${name}[16];\n")
        continue()
    elseif(type STREQUAL "u32")
        set(cppType "std::uint32_t")
        set(csType uint)
    elseif(type STREQUAL "i32")
        set(cppType "std::int32_t")
        set(csType int)
    elseif(type STREQUAL "u64")
        set(cppType "std::uint64_t")
        set(csType ulong)
    elseif(type STREQUAL "f64")
        set(cppType double)
        set(csType double)
    elseif(type STREQUAL "pointer")
        set(cppType "std::uintptr_t")
        set(csType nint)
    else()
        message(FATAL_ERROR "Unsupported ABI schema type: ${type}")
    endif()
    string(APPEND cpp "    ${cppType} ${name}{};\n")
    string(APPEND cs "    /// <summary>ABI ${name} slot (${type}); interpreted by the selected operation.</summary>\n    public ${csType} ${name};\n")
endforeach()
string(APPEND cpp "};\n#pragma pack(pop)\nstatic_assert(sizeof(void*) != 8 || sizeof(Request) == 160);\n}\n")
string(APPEND cs "}\n")
file(MAKE_DIRECTORY "${OUTPUT_DIR}")
# configure_file COPYONLY preserves timestamps when generated content is equal.
file(WRITE "${OUTPUT_DIR}/ScriptApi.h.tmp" "${cpp}")
file(WRITE "${OUTPUT_DIR}/ScriptApi.cs.tmp" "${cs}")
configure_file("${OUTPUT_DIR}/ScriptApi.h.tmp" "${OUTPUT_DIR}/ScriptApi.h" COPYONLY)
configure_file("${OUTPUT_DIR}/ScriptApi.cs.tmp" "${OUTPUT_DIR}/ScriptApi.cs" COPYONLY)
file(REMOVE "${OUTPUT_DIR}/ScriptApi.h.tmp" "${OUTPUT_DIR}/ScriptApi.cs.tmp")
