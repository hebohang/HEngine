ng:border-box;overflow:hidden;margin:0dp;padding:0dp;background-color:#80ed99;color:#122230;font-size:18dp;border-radius:6dp;border:0dp #00000000;pointer-events:auto;left:50%;margin-left:5dp;width:140dp;top:100%;margin-top:-58dp;height:40dp;font-family:&#39;Noto Sans SC&#39;;white-space:nowrap">开始守护</button><button id="portable_action_3" style="position:absolute;box-sizing:border-box;overflow:hidden;margin:0dp;padding:0dp;background-color:#80ed99;color:#122230;font-size:18dp;border-radius:6dp;border:0dp #00000000;pointer-events:auto;left:50%;margin-left:155dp;width:140dp;top:100%;margin-top:-58dp;height:40dp;font-family:&#39;Noto Sans SC&#39;;white-space:nowrap">开始守护</button></div></body></rml>
