include_guard(GLOBAL)
if(NOT WIN32)
    return()
endif()
# Compiler target, not the machine running CMake (cross builds may differ).
string(TOLOWER "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}" heCompilerArchitecture)
string(TOLOWER "${CMAKE_GENERATOR_PLATFORM}" heGeneratorArchitecture)
if(heCompilerArchitecture STREQUAL "arm64" OR heGeneratorArchitecture STREQUAL "arm64")
    set(HE_WINDOWS_ARCH "arm64")
    set(CMAKE_SYSTEM_PROCESSOR "ARM64")
elseif(heCompilerArchitecture STREQUAL "x64" OR heCompilerArchitecture STREQUAL "amd64" OR
       heGeneratorArchitecture STREQUAL "x64")
    set(HE_WINDOWS_ARCH "x64")
    set(CMAKE_SYSTEM_PROCESSOR "AMD64")
else()
    message(FATAL_ERROR "Unsupported Windows compiler architecture: ${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}")
endif()
message(STATUS "HEngine Windows target architecture: ${HE_WINDOWS_ARCH}")

function(he_require_windows_binary_architecture path)
    file(SIZE "${path}" heBinarySize)
    if(heBinarySize LESS 64)
        message(FATAL_ERROR "Truncated native runtime: ${path}")
    endif()
    file(READ "${path}" heDosMagic OFFSET 0 LIMIT 2 HEX)
    file(READ "${path}" hePePointer OFFSET 60 LIMIT 4 HEX)
    string(SUBSTRING "${hePePointer}" 0 2 b0)
    string(SUBSTRING "${hePePointer}" 2 2 b1)
    string(SUBSTRING "${hePePointer}" 4 2 b2)
    string(SUBSTRING "${hePePointer}" 6 2 b3)
    math(EXPR hePeOffset "0x${b3}${b2}${b1}${b0}")
    math(EXPR hePeEnd "${hePeOffset} + 6")
    if(NOT heDosMagic STREQUAL "4d5a" OR hePeEnd GREATER heBinarySize)
        message(FATAL_ERROR "Invalid native PE runtime: ${path}")
    endif()
    file(READ "${path}" heSignature OFFSET ${hePeOffset} LIMIT 4 HEX)
    math(EXPR heMachineOffset "${hePeOffset} + 4")
    file(READ "${path}" heMachine OFFSET ${heMachineOffset} LIMIT 2 HEX)
    if(HE_WINDOWS_ARCH STREQUAL "arm64")
        set(heExpectedMachine "64aa")
    else()
        set(heExpectedMachine "6486")
    endif()
    if(NOT heSignature STREQUAL "50450000" OR NOT heMachine STREQUAL heExpectedMachine)
        message(FATAL_ERROR "Native runtime is not Windows ${HE_WINDOWS_ARCH}: ${path}. Supply a pinned native runtime or explicitly disable the optional feature.")
    endif()
endfunction()
