include_guard(GLOBAL)

function(he_enable_imgui_glfw_compat)
    if(NOT APPLE OR NOT TARGET imgui)
        return()
    endif()
    set(vendorDirectory "${EngineSourceDir}/ThirdParty/imgui/backends")
    set(vendorSource "${vendorDirectory}/imgui_impl_glfw.cpp")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${vendorSource}")
    file(READ "${vendorSource}" source)
    string(REPLACE "\r\n" "\n" source "${source}")
    string(SHA256 sourceHash "${source}")
    if(NOT sourceHash STREQUAL "066801a89de9d58d4f48777f89df35e9b6d741dbbd501136fb40ad86a0658352")
        message(FATAL_ERROR "The vendored ImGui GLFW backend changed; review its macOS event-modifier overlay.")
    endif()
    set(anchor "static void ImGui_ImplGlfw_UpdateKeyModifiers(ImGuiIO& io, GLFWwindow* window)\n{")
    set(replacement "${anchor}\n    int modifiers = 0;\n    if (HEngine::TryGetGlfwEventModifiers(modifiers))\n    {\n        io.AddKeyEvent(ImGuiMod_Ctrl, (modifiers & GLFW_MOD_CONTROL) != 0);\n        io.AddKeyEvent(ImGuiMod_Shift, (modifiers & GLFW_MOD_SHIFT) != 0);\n        io.AddKeyEvent(ImGuiMod_Alt, (modifiers & GLFW_MOD_ALT) != 0);\n        io.AddKeyEvent(ImGuiMod_Super, (modifiers & GLFW_MOD_SUPER) != 0);\n        return;\n    }")
    string(REPLACE "${anchor}" "${replacement}" source "${source}")
    string(PREPEND source "#include \"Runtime/Platform/GLFW/GlfwEventModifiers.h\"\n")
    set(overlayDirectory "${CMAKE_BINARY_DIR}/generated/thirdparty/imgui/backends")
    file(MAKE_DIRECTORY "${overlayDirectory}")
    set(overlaySource "${overlayDirectory}/imgui_impl_glfw.cpp")
    file(CONFIGURE OUTPUT "${overlaySource}" CONTENT "${source}" @ONLY)
    configure_file("${vendorDirectory}/imgui_impl_glfw.h" "${overlayDirectory}/imgui_impl_glfw.h" COPYONLY)
    get_target_property(sources imgui SOURCES)
    list(FIND sources "${vendorSource}" sourceIndex)
    if(sourceIndex EQUAL -1)
        message(FATAL_ERROR "Cannot locate the vendored ImGui GLFW source in the imgui target.")
    endif()
    list(REMOVE_AT sources ${sourceIndex})
    list(APPEND sources "${overlaySource}")
    set_property(TARGET imgui PROPERTY SOURCES "${sources}")
    target_include_directories(imgui PRIVATE "${EngineSourceDir}")
endfunction()
