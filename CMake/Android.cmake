# Android consumes the same shipping runtime; host tools are supplied explicitly
# because a cross build cannot execute its own ARM64 compiler/cooker outputs.
if(NOT CMAKE_ANDROID_ARCH_ABI STREQUAL "arm64-v8a")
    message(FATAL_ERROR "HEngine Android currently requires arm64-v8a.")
endif()
if(ANDROID_PLATFORM_LEVEL LESS 29)
    message(FATAL_ERROR "HEngine Android requires API 29 or newer.")
endif()
set(PACK_GAME ON CACHE BOOL "Android shipping runtime" FORCE)
set(HE_BUILD_DEV_GAME OFF CACHE BOOL "Exclude the developer runtime" FORCE)
set(HE_ENABLE_GM OFF CACHE BOOL "Exclude GM from Android" FORCE)
set(HE_RENDER_DX12 OFF CACHE BOOL "Android uses Vulkan" FORCE)
set(HE_RENDER_VULKAN ON CACHE BOOL "Android uses Vulkan" FORCE)
set(CMAKE_POSITION_INDEPENDENT_CODE ON)
set(CMAKE_POLICY_VERSION_MINIMUM 3.5)
add_link_options("-Wl,-z,max-page-size=16384")
# Reflection is emitted by the Windows host parser before target compilation.
add_compile_definitions(NOMINMAX)
set(HE_ANDROID_HOST_CONTENT "" CACHE PATH "Verified host-cooked content directory")
set(HE_CODEGEN_PARSER_EXECUTABLE "" CACHE FILEPATH "Host HEngineParser executable")
if(NOT HE_PORTABLE_PLAYER AND NOT EXISTS "${HE_ANDROID_HOST_CONTENT}/Game.pak")
    message(FATAL_ERROR "Supply HE_ANDROID_HOST_CONTENT containing host-cooked Game.pak.")
endif()
if(NOT EXISTS "${HE_CODEGEN_PARSER_EXECUTABLE}")
    message(FATAL_ERROR "Android requires a host HE_CODEGEN_PARSER_EXECUTABLE.")
endif()
