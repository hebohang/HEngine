body {
  margin: 0px;
  padding: 0px;
  width: 100%;
  height: 100%;
  overflow: hidden;
  font-family: 'Open Sans';
  font-weight: normal;
  font-style: normal;
}

#canvas_root {
  position: absolute;
  background-color: #ffffff00;
  color: #ffffffff;
  overflow: hidden;
  pointer-events: none;
  font-family: 'Open Sans';
  font-weight: normal;
  font-style: normal;
  font-size: 24dp;
}

#hud_root {
  position: absolute;
  background-color: rgba(255, 255, 255, 0);
  color: #ffffff00;
  border: 1dp rgba(90, 170, 255, 0);
  border-radius: 12dp;
  overflow: hidden;
  pointer-events: auto;
  font-family: 'Open Sans';
  font-weight: normal;
  font-style: normal;
  font-size: 18dp;
  padding: 16px; 
}

#score_label {
  position: absolute;
  background-color: #00000000;
  color: #57ff9aff;
  overflow: hidden;
  pointer-events: none;
  font-family: 'Open Sans';
  font-weight: normal;
  font-style: normal;
  font-size: 22dp;
  margin: 0dp;
  font-weight: bold; 
}

#hp_label {
  position: absolute;
  background-color: #00000000;
  color: #d7e8ffff;
  overflow: hidden;
  pointer-events: none;
  font-family: 'Open Sans';
  font-weight: normal;
  font-style: normal;
  font-size: 14dp;
  margin: 0dp;
}

#hp_fill {
  position: absolute;
  background-color: rgba(64, 224, 120, 220);
  color: #ffffffff;
  border-radius: 6dp;
  overflow: hidden;
  pointer-events: none;
  font-family: 'Open Sans';
  font-weight: normal;
  font-style: normal;
  font-size: 12dp;
}

#shield_label {
  position: absolute;
  background-color: #00000000;
  color: #d7e8ffff;
  overflow: hidden;
  pointer-events: none;
  font-family: 'Open Sans';
  font-weight: normal;
  font-style: normal;
  font-size: 14dp;
  margin: 0dp;
}

#shield_fill {
  position: absolute;
  background-color: rgba(92, 150, 255, 220);
  color: #ffffffff;
  border-radius: 6dp;
  overflow: hidden;
  pointer-events: none;
  font-family: 'Open Sans';
  font-weight: normal;
  font-style: normal;
  font-size: 12dp;
}

